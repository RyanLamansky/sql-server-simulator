<Project>

  <!-- Shared defaults for every project in the repo. A project overrides by
       setting the property in its own csproj (imported after this file) —
       e.g. the analyzer targets netstandard2.0 and the main package opts back
       into IsPackable. Package versions are centralized separately in
       Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Only SqlServerSimulator publishes; everything else opts out here and
         the package project sets true. -->
    <IsPackable>false</IsPackable>
    <!-- Exclude test run debris from build consideration. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TestResults/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Trim analysis (IL2xxx / IL3xxx, from IsTrimmable) is the costliest
       analyzer in a build and has never been seen to fail, so it runs only in
       Release, which CI's Release leg builds; `dotnet build -c Release` runs it
       locally. See docs/claude/build-analyzers.md for the measurements. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release'">
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- A test host runs its tests on every core at once, each allocating as it
       goes; server GC collects on every core, where workstation GC stops all
       of them while one thread collects. Matched by name, since IsTestProject
       is set only after this file is read. See docs/claude/build-analyzers.md
       for the measurements. -->
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.Tests'))">
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory).editorconfig" Link=".editorconfig" />
  </ItemGroup>

</Project>
