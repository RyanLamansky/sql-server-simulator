<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>SQL Server Simulator</Title>
    <AssemblyTitle>SQL Server Simulator</AssemblyTitle>
    <Authors>Ryan Lamansky</Authors>
    <Description>A simulated SQL Server that runs inside your .NET application.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>SQL Server feature compatibility is rich but imperfect, see the README for more information.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/RyanLamansky/sql-server-simulator</PackageProjectUrl>
    <Copyright>Copyright © Ryan Lamansky. All rights reserved.</Copyright>
    <PackageTags>SqlServer SQL</PackageTags>
    <RepositoryUrl>https://github.com/RyanLamansky/sql-server-simulator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The one project that publishes; Directory.Build.props defaults the
         rest of the repo to IsPackable false. -->
    <IsPackable>true</IsPackable>
    <IsTrimmable>true</IsTrimmable>
    <AnalysisMode>All</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SqlServerSimulator.Tests.Internal" />
    <InternalsVisibleTo Include="SqlServerSimulator.Tests.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlServerSimulator.Analyzers\SqlServerSimulator.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- Built, never referenced: its output is embedded below and loaded only
         into the load context that hosts CREATE ASSEMBLY assemblies (see
         Clr/ClrHost.cs), so none of its public types reach a consumer. -->
    <ProjectReference Include="..\SqlServerSimulator.ClrShim\SqlServerSimulator.ClrShim.csproj" OutputItemType="ClrShimAssembly" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Parser/FullText/SystemStopwords.tsv" LogicalName="SqlServerSimulator.FullText.SystemStopwords.tsv" />
    <EmbeddedResource Include="Parser/FullText/KeywordAccents.tsv" LogicalName="SqlServerSimulator.FullText.KeywordAccents.tsv" />
    <EmbeddedResource Include="Parser/FullText/CharacterClasses.tsv" LogicalName="SqlServerSimulator.FullText.CharacterClasses.tsv" />
    <EmbeddedResource Include="Parser/Expressions/FormatCultures.tsv" LogicalName="SqlServerSimulator.Format.Cultures.tsv" />
    <EmbeddedResource Include="Collation.CjkPrimary.txt" LogicalName="SqlServerSimulator.Collation.CjkPrimary.txt" />
    <EmbeddedResource Include="Storage/Spatial/SpatialReferenceSystems.tsv" LogicalName="SqlServerSimulator.Spatial.SpatialReferenceSystems.tsv" />
    <EmbeddedResource Include="Storage/WaitTypes.txt" LogicalName="SqlServerSimulator.WaitTypes.txt" />
    <EmbeddedResource Include="Storage/LatchClasses.txt" LogicalName="SqlServerSimulator.LatchClasses.txt" />
    <EmbeddedResource Include="Storage/MemoryClerks.tsv" LogicalName="SqlServerSimulator.MemoryClerks.tsv" />
    <EmbeddedResource Include="Storage/PerformanceCounters.tsv" LogicalName="SqlServerSimulator.PerformanceCounters.tsv" />
    <EmbeddedResource Include="WindowsTimeZones.tsv" LogicalName="SqlServerSimulator.WindowsTimeZones.tsv" />
    <EmbeddedResource Include="Schemas/SystemTables.txt" LogicalName="SqlServerSimulator.SystemTables.txt" />
    <EmbeddedResource Include="Schemas/CatalogViewComputedColumns.tsv" LogicalName="SqlServerSimulator.CatalogViewComputedColumns.tsv" />
    <EmbeddedResource Include="Registry.tsv" LogicalName="SqlServerSimulator.Registry.tsv" />
    <!-- The Extended Events catalog is some 3 MB of text, zipped by the target
         below so the assembly carries a tenth of that. -->
    <XeMetadataFile Include="ExtendedEvents/Metadata/*.tsv" />
    <EmbeddedResource Include="ExtendedEvents/DefaultSessions.tsv" LogicalName="SqlServerSimulator.XeDefaultSessions.tsv" />
    <EmbeddedResource Include="ExtendedEvents/InternalSessions.tsv" LogicalName="SqlServerSimulator.XeInternalSessions.tsv" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)XeMetadata.zip" LogicalName="SqlServerSimulator.XeMetadata.zip" />
    <!-- SQL Trace's catalog, zipped the same way. -->
    <TraceMetadataFile Include="Trace/Metadata/*.tsv" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)TraceMetadata.zip" LogicalName="SqlServerSimulator.TraceMetadata.zip" />
    <!-- SQL Server Audit's catalog (some 80 KB of text), zipped the same way. -->
    <AuditMetadataFile Include="Audit/Metadata/*.tsv" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)AuditMetadata.zip" LogicalName="SqlServerSimulator.AuditMetadata.zip" />
  </ItemGroup>

  <Target Name="ZipXeMetadata" BeforeTargets="PrepareResourceNames" Inputs="@(XeMetadataFile)" Outputs="$(BaseIntermediateOutputPath)XeMetadata.zip">
    <ZipDirectory SourceDirectory="ExtendedEvents/Metadata" DestinationFile="$(BaseIntermediateOutputPath)XeMetadata.zip" Overwrite="true" />
  </Target>

  <Target Name="ZipTraceMetadata" BeforeTargets="PrepareResourceNames" Inputs="@(TraceMetadataFile)" Outputs="$(BaseIntermediateOutputPath)TraceMetadata.zip">
    <ZipDirectory SourceDirectory="Trace/Metadata" DestinationFile="$(BaseIntermediateOutputPath)TraceMetadata.zip" Overwrite="true" />
  </Target>

  <Target Name="ZipAuditMetadata" BeforeTargets="PrepareResourceNames" Inputs="@(AuditMetadataFile)" Outputs="$(BaseIntermediateOutputPath)AuditMetadata.zip">
    <ZipDirectory SourceDirectory="Audit/Metadata" DestinationFile="$(BaseIntermediateOutputPath)AuditMetadata.zip" Overwrite="true" />
  </Target>

  <Target Name="EmbedClrShimAssembly" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(ClrShimAssembly)" LogicalName="Microsoft.SqlServer.Server.dll" />
    </ItemGroup>
  </Target>

</Project>
