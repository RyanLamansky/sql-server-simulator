<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SltRunner</AssemblyName>
    <RootNamespace>SltRunner</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- A project reference, so building the runner rebuilds the simulator it
         measures. The simulator builds under the repo's own settings; this
         directory's Directory.Build.* files keep them off the runner. -->
    <ProjectReference Include="../../../src/SqlServerSimulator/SqlServerSimulator.csproj" />
  </ItemGroup>

</Project>
